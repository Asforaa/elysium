{
  "name": "elysium",
  "version": "0.0.0",
  "description": "Elysium is a private, selfhostable local media download hub for personal use.",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check": "turbo check",
    "test": "turbo test",
    "web:dev": "bun run --filter @elysium/web dev",
    "api:dev": "bun run --filter @elysium/api start:dev",
    "db:start": "bun run --filter @elysium/api db:start",
    "db:status": "bun run --filter @elysium/api db:status",
    "db:stop": "bun run --filter @elysium/api db:stop",
    "db:ping": "bun run --filter @elysium/api db:ping"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "turbo": "^2.9.14"
  }
}
