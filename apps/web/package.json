{
  "name": "@elysium/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "vite --host 127.0.0.1 --port ${PORT:-5173}",
    "dev:portless": "portless",
    "routes:generate": "tsr generate",
    "build": "bun run routes:generate && tsc -b && vite build",
    "check": "bun run routes:generate && tsc -b",
    "lint": "eslint . || true",
    "lint:strict": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@elysium/shared": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.139.3",
    "@tanstack/react-table": "^8.21.3",
    "@videojs/react": "^10.0.0-beta.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "portless": {
    "appPort": 5173,
    "name": "elysium",
    "script": "dev:app"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-cli": "^1.167.10",
    "@tanstack/router-plugin": "^1.168.11",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "agentation": "^3.0.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
